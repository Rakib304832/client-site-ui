# The Next.js app and the Express API must use the same MongoDB database.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/studiospace

# Express API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# In Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth 2.0 Client IDs, add this authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
